auto-install-peers=false
strict-peer-dependencies=false

# Tell pnpm to download optional native binaries for ALL target platforms.
# This is REQUIRED so CI runners (win32, darwin, linux) each get their own
# platform-specific .node files (esbuild, lightningcss, etc.).
# pnpm v10 requires the array bracket syntax — dotted keys are NOT supported.
supportedArchitectures[os][]=linux
supportedArchitectures[os][]=win32
supportedArchitectures[os][]=darwin
supportedArchitectures[cpu][]=x64
supportedArchitectures[cpu][]=arm64
