auto-install-peers=false
strict-peer-dependencies=false

# pnpm v10 dot-notation for downloading cross-platform optional native binaries.
# This ensures lightningcss, esbuild etc. are installed for ALL target platforms
# regardless of which OS the install runs on.
supportedArchitectures.os[]=linux
supportedArchitectures.os[]=win32
supportedArchitectures.os[]=darwin
supportedArchitectures.cpu[]=x64
supportedArchitectures.cpu[]=arm64
