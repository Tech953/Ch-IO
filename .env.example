# ============================================================
# ENGRAM / PYRI — local (offline) + free-online configuration
#
# Copy this file to ".env" and edit. The local setup scripts do this for you.
# Lines starting with "#" are comments. Avoid spaces around "=".
# ============================================================

# --- Database (required for local/desktop) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engram

# --- Server ---
PORT=5000

# ============================================================
# LLM PROVIDER — pick ONE block below, uncomment, and fill in.
# The default is Ollama (fully offline, no account required).
# ============================================================

# ── OPTION 1: Ollama (offline, free, recommended) ──────────
# Install: https://ollama.com  |  Pull a model: ollama pull llama3.1
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=local

# ── OPTION 2: LM Studio (offline, free) ────────────────────
# Enable the local server in LM Studio on port 1234.
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model
# LLM_API_KEY=local

# ── OPTION 3: Groq (online, FREE tier, very fast) ──────────
# Sign up free at https://console.groq.com  — no credit card required.
# Free tier: ~30 req/min on Llama 3.3 70B.
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# ── OPTION 4: OpenRouter (online, FREE models available) ───
# Sign up free at https://openrouter.ai — many free model options.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your_key_here
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── OPTION 5: HuggingFace Inference API (online, free tier) ─
# Sign up free at https://huggingface.co — free inference credits.
# LLM_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=hf_your_key_here
# LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ── OPTION 6: Any OpenAI-compatible server (custom) ─────────
# LLM_BASE_URL=http://your-server/v1
# LLM_API_KEY=your_key_or_local
# LLM_MODEL=your-model-name

# --- Optional: multimodal ---
# LLM_VISION_MODEL=llava
# LLM_TRANSCRIBE_MODEL=whisper

# --- Optional: tuning ---
# LOG_LEVEL=info
# MEDIA_MAX_BYTES=26214400

# --- Desktop download link (build-time only) ---
# VITE_DESKTOP_RELEASES_URL=https://github.com/Tech953/Ch-IO/releases/latest
